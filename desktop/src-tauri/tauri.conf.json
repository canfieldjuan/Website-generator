{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Website Generator",
  "version": "0.1.0",
  "identifier": "com.eom.website-generator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Website Generator",
        "width": 1440,
        "height": 920,
        "minWidth": 720,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; frame-src blob:; style-src 'self' 'unsafe-inline' https:; font-src 'self' data: https:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
